# Streamlit Community Cloud deployment secrets template
# Copy to .streamlit/secrets.toml and fill in live values for production MySQL deployment
# DO NOT commit secrets.toml to Git

# Optional: set to true to force SQLite embedded database on cloud
USE_SQLITE = "true"

# Optional: live MySQL/TiDB connection (only needed if USE_SQLITE=false)
# MYSQL_HOST = "your-cloud-mysql-host"
# MYSQL_PORT = 3306
# MYSQL_USER = "retailpulse_app"
# MYSQL_PASSWORD = "your-secure-password"
# MYSQL_DATABASE = "retailpulse_db"

